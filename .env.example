# DishWipe AI — Root Environment Variables
# Copy to .env for local monorepo scripts (optional)

# Frontend (Vite) — create frontend/.env.local for local overrides
# VITE_API_URL=http://localhost:5000

# Backend — create backend/.env for local API server
# PORT=5000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173

# Vercel production — set in Vercel Project Settings → Environment Variables
# FRONTEND_URL=https://your-app.vercel.app
# VITE_API_URL= (leave empty for same-origin /api on Vercel)
